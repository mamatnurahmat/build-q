# ─────────────────────────────────────────────────────────────────────────
# .env — Jev Web Chat (bq --serve) Docker Compose configuration
#
# Copy ke .env dan isi field yg di-mark WAJIB (minimal supaya jalan).
#
#   cp .env.example .env
#   # edit .env, lalu:
#   docker compose up -d --build
# ─────────────────────────────────────────────────────────────────────────

# ─── Build args ──────────────────────────────────────────────────────────
BUILD_Q_VERSION=0.1.42

# ─── Host port exposure ──────────────────────────────────────────────────
# Default: 8888 di LAN. Untuk localhost-only, ubah compose.yaml ports ke
# "127.0.0.1:8888:8888".
JEV_HOST_PORT=8888

# ═════════════════════════════════════════════════════════════════════════
# Jev provider — PILIH SALAH SATU API key (WAJIB)
# ═════════════════════════════════════════════════════════════════════════
JEV_PROVIDER=typesafe

# TypeSafe direct (default)
TYPESAFE_API_KEY=sk-ts-xxxxxxxxxxxxxxxxxxxxxx

# OpenRouter (alternatif — set JEV_PROVIDER=openrouter)
OPENROUTER_API_KEY=

# ═════════════════════════════════════════════════════════════════════════
# PocketBase IDP (optional — centralized credentials)
# Bila PB_API=true, bq akan auto-hydrate secret dari PB → tdk perlu set
# GITHUB_TOKEN manual di sini. User cukup set PB_API_USER+PASS.
# ═════════════════════════════════════════════════════════════════════════
PB_API=true
PB_API_URL=https://cicd-hw.qoin.id/devops
PB_API_USER=
PB_API_PASS=

# ═════════════════════════════════════════════════════════════════════════
# GitHub — hanya diperlukan bila PB_API=false, atau sbg fallback
# ═════════════════════════════════════════════════════════════════════════
GITHUB_TOKEN=
GITHUB_ORG=Qoin-Digital-Indonesia
GH_CLI=false

# ═════════════════════════════════════════════════════════════════════════
# Docker Hub + Registry — image push target
# ═════════════════════════════════════════════════════════════════════════
DOCKERHUB_ORG=loyaltolpi
REGISTRY_URL=docker.io/loyaltolpi

# ═════════════════════════════════════════════════════════════════════════
# SOPS encryption (bq --sops-encrypt, bootstrap-k8s secrets)
# ═════════════════════════════════════════════════════════════════════════
# Public age key(s), comma-separated untuk multi-recipient.
# Format: age1xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BUILD_Q_SOPS_AGE_RECIPIENT=

# ═════════════════════════════════════════════════════════════════════════
# Serve mode — AUTH (SANGAT disarankan bila expose ke LAN/network)
# ═════════════════════════════════════════════════════════════════════════
# Bearer token untuk /api/*. Generate: openssl rand -hex 24
# Browser URL pertama kali: http://IP:8888/?token=TOKEN
# (auto-save ke localStorage, bisa dihapus dari URL)
BQ_SERVE_TOKEN=

# Read-only / demo mode (decide-only, tolak /api/execute).
# Set ke "true" untuk screencast / demo publik.
BQ_SERVE_NO_EXEC=

# ═════════════════════════════════════════════════════════════════════════
# Volume paths (optional override)
# ═════════════════════════════════════════════════════════════════════════
# Path kubeconfig di host; default $HOME/.kube/config.
# KUBECONFIG_HOST=/path/to/custom/kubeconfig

# ═════════════════════════════════════════════════════════════════════════
# Build-q tuning
# ═════════════════════════════════════════════════════════════════════════
# TTL cache TUI katalog PocketBase (detik). 0 = selalu refresh.
BUILD_Q_TUI_CACHE_TTL=3600
