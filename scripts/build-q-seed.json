      "params": {
        "repo": {
          "type": "text",
          "hint": "nama repo (mis. pay-be-topup-manager, saas-apigateway)"
        },
        "ref": {
          "type": "text",
          "hint": "branch atau tag (develop, staging, main, v1.2.3)"
        }
      },
      "risky": true,
      "active": true,
      "order": 0,
      "notes": ""
    },
