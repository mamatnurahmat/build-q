    {
      "name": "bq_bootstrap_k8s",
      "category": "k8s",
      "description": "Bootstrap manifest K8s (Secret + Deployment + Service) ke repo GitOps. Butuh <repo> <ref> + --gitops-repo + --gitops-branch + --path-yaml. Opsional: --apply-secret, --kube-context, --namespace, --nodepool, --force-recreate-deploy.",
      "template": "bq --bootstrap-k8s {repo} {ref} --gitops-repo {gitops_repo} --gitops-branch {branch} --path-yaml {path_yaml} --env {env} --replicas {replicas}",
      "params": {
        "repo": {
          "type": "text",
          "hint": "nama repo source (mis. pay-be-topup-manager)"
        },
        "ref": {
          "type": "text",
          "hint": "branch/tag source (develop, staging, main, v1.2.3)"
        },
        "gitops_repo": {
          "type": "text",
          "default": "gitops",
          "hint": "repo gitops (default: gitops)"
        },
        "branch": {
          "type": "text",
          "default": "main",
          "hint": "branch gitops (default: main)"
        },
        "path_prefix": {
          "type": "choice",
          "options": [
            "cce",
            "k8s"
          ],
          "default": "cce"
        },
        "path_yaml": {
          "type": "text",
          "default_template": "{path_prefix}/{namespace}/{deployment}_deployment.yaml",
          "hint": "path YAML (auto: <prefix>/<ns>/<deployment>_deployment.yaml)"
        },
        "env": {
          "type": "choice",
          "options": [
            "develop",
            "staging",
            "production"
          ]
        },
        "replicas": {
          "type": "text",
          "default": "2",
          "hint": "jumlah replica (default 2)"
        },
        "kube_context": {
          "type": "text",
          "hint": "kube context (mis. hw-pro-p) — pakai dgn --apply-secret"
        },
        "namespace": {
          "type": "text",
          "hint": "namespace K8s"
        },
        "deployment": {
          "type": "text",
          "hint": "nama deployment (utk derive path_yaml)"
        }
      },
      "risky": true,
      "active": true,
      "order": 18,
      "notes": ""
    },
